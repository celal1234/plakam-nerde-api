NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://plakam:plakam@localhost:5432/plakam
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
# Virgülle ayrılmış; mobil uygulama CORS'a takılmaz, yalnızca web/admin için gerekir.
CORS_ORIGINS=
RUN_MIGRATIONS=true
# En az 32 karakter; üretimde `openssl rand -base64 48` ile üret.
JWT_SECRET=change-me-change-me-change-me-change-me
APP_URL=http://localhost:3000
# Boşsa e-postalar gönderilmez, loga yazılır. Örnek: smtps://kullanici:sifre@smtp-relay.brevo.com:465
SMTP_URL=
MAIL_FROM=Plakam Nerde? <no-reply@plakamnerde.com>
# S3 uyumlu depolama; kova herkese kapalı olmalı.
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=plakam-photos
S3_ACCESS_KEY=
S3_SECRET_KEY=
